# Copy to .env only if you need to override defaults.

# Backend origin. Leave empty in dev — Vite proxies /health and /api to the
# backend (see vite.config.ts). Set this when the backend is on another host.
VITE_API_BASE_URL=

# Where the Vite dev-server proxy forwards /health and /api (dev only).
VITE_PROXY_TARGET=http://localhost:8000
